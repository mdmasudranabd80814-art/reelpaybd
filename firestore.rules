rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    // Mandatory email verification for ALL authenticated access
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         request.auth.token.email is string &&
         request.auth.token.email.lower() == 'mdmasudranabd80814@gmail.com' &&
         request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'points', 'role', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'name', 'phone', 'email', 'password', 'points', 'role', 'avatar',
               'createdAt', 'totalWithdrawn', 'reelsWatchedCount', 'referralCode',
               'referredBy', 'referralBonusClaimed', 'isVerified', 'lastActive',
               'paymentMethod', 'paymentAccountNumber', 'paymentAccountHolder',
               'paymentBankName', 'paymentBranchName', 'levelName', 'multiplier',
               'dailyClaimedDate', 'lastPage', 'totalSessions', 'followersCount',
               'followingCount', 'followers', 'following', 'completedTaskIds',
                'dailyReelClaimDate', 'dailyReelClaimsCount', 'dailyReelPointsEarned',
                'dailyTotalEarnedDate', 'dailyTotalPointsEarned',
                'dailyTaskClaimDate', 'dailyTaskClaimsCount', 'dailyCompletedTaskIds',
                'dailyReferralDate', 'dailyReferralsCount',
                'loginOfferClaimed', 'loginOfferCampaignId', 'dailySpinClaimDate',
                'dailySpinClaimsCount', 'dailyScratchClaimDate', 'referralsCount', 'referralEarnedPoints',
                'likedReelIds', 'likedCommentIds'
              ]) &&
              data.id is string && data.id.size() <= 128 &&
              data.name is string && data.name.size() <= 100 &&
              data.phone is string && data.phone.size() <= 20 &&
              data.points is number && data.points >= 0 &&
              data.role in ['user', 'admin'] &&
              data.createdAt is string && data.createdAt.size() <= 64 &&
              (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
              (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100)) &&
              (!('paymentAccountNumber' in data) || (data.paymentAccountNumber is string && data.paymentAccountNumber.size() <= 100)) &&
              (!('paymentAccountHolder' in data) || (data.paymentAccountHolder is string && data.paymentAccountHolder.size() <= 120)) &&
              (!('paymentBankName' in data) || (data.paymentBankName is string && data.paymentBankName.size() <= 120)) &&
              (!('paymentBranchName' in data) || (data.paymentBranchName is string && data.paymentBranchName.size() <= 120)) &&
              (!('completedTaskIds' in data) || (data.completedTaskIds is list && data.completedTaskIds.size() <= 500)) &&
              (!('dailyCompletedTaskIds' in data) || (data.dailyCompletedTaskIds is list && data.dailyCompletedTaskIds.size() <= 500)) &&
              (!('followers' in data) || (data.followers is list && data.followers.size() <= 1000)) &&
              (!('following' in data) || (data.following is list && data.following.size() <= 1000)) &&
              (!('dailyReelClaimDate' in data) || (data.dailyReelClaimDate is string && data.dailyReelClaimDate.size() <= 20)) &&
              (!('dailyReelClaimsCount' in data) || (data.dailyReelClaimsCount is number && data.dailyReelClaimsCount >= 0)) &&
              (!('dailyReelPointsEarned' in data) || (data.dailyReelPointsEarned is number && data.dailyReelPointsEarned >= 0)) &&
              (!('dailyTotalEarnedDate' in data) || (data.dailyTotalEarnedDate is string && data.dailyTotalEarnedDate.size() <= 20)) &&
              (!('dailyTotalPointsEarned' in data) || (data.dailyTotalPointsEarned is number && data.dailyTotalPointsEarned >= 0)) &&
              (!('dailyTaskClaimDate' in data) || (data.dailyTaskClaimDate is string && data.dailyTaskClaimDate.size() <= 20)) &&
              (!('dailyTaskClaimsCount' in data) || (data.dailyTaskClaimsCount is number && data.dailyTaskClaimsCount >= 0)) &&
              (!('dailyReferralDate' in data) || (data.dailyReferralDate is string && data.dailyReferralDate.size() <= 20)) &&
              (!('dailyReferralsCount' in data) || (data.dailyReferralsCount is number && data.dailyReferralsCount >= 0)) &&
              (!('loginOfferClaimed' in data) || data.loginOfferClaimed is bool) &&
              (!('loginOfferCampaignId' in data) || (data.loginOfferCampaignId is string && data.loginOfferCampaignId.size() <= 100)) &&
              (!('dailySpinClaimDate' in data) || (data.dailySpinClaimDate is string && data.dailySpinClaimDate.size() <= 40)) &&
              (!('dailySpinClaimsCount' in data) || (data.dailySpinClaimsCount is number && data.dailySpinClaimsCount >= 0)) &&
              (!('dailyScratchClaimDate' in data) || (data.dailyScratchClaimDate is string && data.dailyScratchClaimDate.size() <= 40)) &&
              (!('referralsCount' in data) || (data.referralsCount is number && data.referralsCount >= 0)) &&
              (!('referralEarnedPoints' in data) || (data.referralEarnedPoints is number && data.referralEarnedPoints >= 0)) &&
              (!('likedReelIds' in data) || (data.likedReelIds is list && data.likedReelIds.size() <= 2000)) &&
              (!('likedCommentIds' in data) || (data.likedCommentIds is list && data.likedCommentIds.size() <= 2000));
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'name', 'avatar', 'isVerified', 'referralCode',
               'followersCount', 'followingCount', 'followers', 'following',
               'reelsWatchedCount', 'points', 'role', 'referralsCount',
               'referralEarnedPoints', 'dailyReferralDate', 'dailyReferralsCount', 'createdAt'
             ]) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 200000)) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 20)) &&
             (!('followers' in data) || (data.followers is list && data.followers.size() <= 1000)) &&
             (!('following' in data) || (data.following is list && data.following.size() <= 1000)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('role' in data) || data.role in ['user', 'admin']) &&
             (!('referralsCount' in data) || (data.referralsCount is number && data.referralsCount >= 0)) &&
             (!('referralEarnedPoints' in data) || (data.referralEarnedPoints is number && data.referralEarnedPoints >= 0)) &&
             (!('dailyReferralDate' in data) || (data.dailyReferralDate is string && data.dailyReferralDate.size() <= 20)) &&
             (!('dailyReferralsCount' in data) || (data.dailyReferralsCount is number && data.dailyReferralsCount >= 0));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'message', 'type', 'createdAt', 'read']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 140 &&
             data.message is string && data.message.size() <= 600 &&
             data.type in ['reel_deleted', 'deposit', 'withdrawal', 'general'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidReel(data) {
      return data.keys().hasAll(['title', 'creatorName', 'category', 'thumbnailUrl', 'createdAt', 'pointsReward']) &&
             data.keys().hasOnly([
               'id', 'userId', 'title', 'creatorName', 'creatorHandle', 'creatorAvatar',
               'isVerified', 'category', 'thumbnailUrl', 'videoUrl', 'likesCount',
               'commentsCount', 'sharesCount', 'pointsReward', 'createdAt', 'viewsCount',
               'audioTrack', 'caption', 'hashtags', 'timeAgo', 'isEarningEnabled',
               'isSpecialOffer', 'specialOfferBadge', 'customWatchSeconds', 'filter', 'watermark',
               'shareToStory', 'storyExpiresAt'
             ]) &&
             data.title is string && data.title.size() <= 200 &&
             data.creatorName is string && data.creatorName.size() <= 100 &&
             data.category in ['সকল', 'মোটিভেশন', 'ট্রেনিং', 'ট্রেন্ডিং', 'কমেডি', 'শর্ট ড্রামা', 'শর্ট মুভি', 'গান', 'বিনোদন', 'গেমিং', 'রান্না', 'শিক্ষা'] &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() <= 200000 &&
             data.pointsReward is number && data.pointsReward >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('shareToStory' in data) || data.shareToStory is bool) &&
             (!('storyExpiresAt' in data) || (data.storyExpiresAt is string && data.storyExpiresAt.size() <= 64)) &&
             (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
             (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
             (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0)) &&
             (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0)) &&
             (!('hashtags' in data) || data.hashtags == null || (data.hashtags is list && data.hashtags.size() <= 15)) &&
             (!('watermark' in data) || (data.watermark is map &&
               (!('enabled' in data.watermark) || data.watermark.enabled is bool) &&
               (!('type' in data.watermark) || data.watermark.type in ['text', 'logo']) &&
               (!('text' in data.watermark) || (data.watermark.text is string && data.watermark.text.size() <= 120)) &&
               (!('logoUrl' in data.watermark) || (data.watermark.logoUrl is string && data.watermark.logoUrl.size() <= 200000)) &&
               (!('position' in data.watermark) || data.watermark.position in ['top-left', 'top-right', 'bottom-left', 'bottom-right', 'center']) &&
               (!('opacity' in data.watermark) || (data.watermark.opacity is number && data.watermark.opacity >= 0 && data.watermark.opacity <= 1)) &&
               (!('size' in data.watermark) || data.watermark.size in ['small', 'medium', 'large']) &&
               (!('color' in data.watermark) || (data.watermark.color is string && data.watermark.color.size() <= 30))));
    }

    function isValidStory(data) {
      return data.keys().hasAll(['id', 'userId', 'creatorName', 'mediaType', 'createdAt', 'expiresAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'creatorName', 'creatorAvatar', 'isVerified',
               'mediaType', 'mediaUrl', 'thumbnailUrl', 'caption', 'bgColor',
               'filter', 'linkedReelId', 'viewsCount', 'likesCount', 'createdAt', 'expiresAt'
             ]) &&
             isValidId(data.id) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() <= 100 &&
             data.mediaType in ['image', 'video', 'text'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.expiresAt is string && data.expiresAt.size() <= 64 &&
             (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 200000)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 500000)) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 200000)) &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 300)) &&
             (!('bgColor' in data) || (data.bgColor is string && data.bgColor.size() <= 60)) &&
             (!('filter' in data) || (data.filter is string && data.filter.size() <= 120)) &&
             (!('linkedReelId' in data) || (data.linkedReelId is string && data.linkedReelId.size() <= 128)) &&
             (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0)) &&
             (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['reelId', 'userId', 'userName', 'text', 'createdAt']) &&
             data.keys().hasOnly(['id', 'reelId', 'userId', 'userName', 'userAvatar', 'text', 'createdAt', 'likes', 'timeAgo']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.reelId is string && data.reelId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.text is string && data.text.size() <= 500 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('likes' in data) || (data.likes is number && data.likes >= 0));
    }

    function isValidWithdrawal(data) {
      return data.keys().hasAll(['userId', 'amountBDT', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'userName', 'userPhone', 'accountNumber', 'accountType',
               'method', 'methodCategory', 'accountHolderName', 'bankName', 'branchName',
               'routingNumber', 'accountDetails', 'pointsDeducted', 'amountBDT',
               'status', 'createdAt', 'transactionId', 'rejectionReason'
             ]) &&
             data.userId == request.auth.uid &&
             data.amountBDT is number && data.amountBDT > 0 &&
             data.status == 'pending' &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('method' in data) || (data.method is string && data.method.size() <= 100)) &&
             (!('accountType' in data) || (data.accountType is string && data.accountType.size() <= 60)) &&
             (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 100)) &&
             (!('methodCategory' in data) || data.methodCategory in ['mobile_banking', 'bank', 'card', 'other']) &&
             (!('accountHolderName' in data) || (data.accountHolderName is string && data.accountHolderName.size() <= 120)) &&
             (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120)) &&
             (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 120)) &&
             (!('routingNumber' in data) || (data.routingNumber is string && data.routingNumber.size() <= 60)) &&
             (!('accountDetails' in data) || (data.accountDetails is string && data.accountDetails.size() <= 500));
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['userId', 'amountBDT', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'userName', 'userPhone', 'method', 'methodCategory',
               'receiverAccountNumber', 'amountBDT', 'pointsToAdd', 'transactionId',
               'senderNumber', 'senderDetails', 'status', 'createdAt', 'notes'
             ]) &&
             data.userId == request.auth.uid &&
             data.amountBDT is number && data.amountBDT > 0 &&
             data.status == 'pending' &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('method' in data) || (data.method is string && data.method.size() <= 100)) &&
             (!('methodCategory' in data) || data.methodCategory in ['mobile_banking', 'bank', 'card', 'other']) &&
             (!('receiverAccountNumber' in data) || (data.receiverAccountNumber is string && data.receiverAccountNumber.size() <= 120)) &&
             (!('senderNumber' in data) || (data.senderNumber is string && data.senderNumber.size() <= 100)) &&
             (!('senderDetails' in data) || (data.senderDetails is string && data.senderDetails.size() <= 500)) &&
             (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 120));
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'participants', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'participants', 'lastMessage', 'lastMessageTime', 'updatedAt']) &&
             data.id is string && data.id.size() <= 260 &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants[0] is string && data.participants[1] is string &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['sessionId', 'senderId', 'text', 'createdAt']) &&
             data.keys().hasOnly(['id', 'sessionId', 'senderId', 'text', 'imageUrl', 'sharedReelId', 'sharedReelThumbnail', 'createdAt', 'isHidden']) &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.sessionId is string && data.sessionId.size() <= 260 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // --- Match Blocks ---

    match /users/{userId} {
      // PII strictly isolated to owner and verified admin
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if (isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == request.auth.uid && incoming().role == 'user') || isAdmin();
      allow update: if isAdmin() ||
                     (isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                      incoming().id == existing().id &&
                      incoming().role == existing().role &&
                      incoming().createdAt == existing().createdAt &&
                      (!('totalWithdrawn' in existing()) || incoming().totalWithdrawn == existing().totalWithdrawn)) ||
                     (isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followers'])) ||
                     (isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['points']) &&
                      incoming().points is number && incoming().points > existing().points &&
                      incoming().points <= existing().points + 1000) ||
                     (isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['points', 'referralsCount', 'referralEarnedPoints', 'dailyReferralDate', 'dailyReferralsCount']) &&
                      incoming().points is number && incoming().points > existing().points &&
                      incoming().points <= existing().points + 1000 &&
                      incoming().referralsCount is number &&
                      (!('referralsCount' in existing()) || incoming().referralsCount <= existing().referralsCount + 1) &&
                      incoming().referralEarnedPoints is number &&
                      (!('referralEarnedPoints' in existing()) || incoming().referralEarnedPoints <= existing().referralEarnedPoints + 1000));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && incoming().userId == userId;
        allow update: if (isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read is bool) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /public_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin() || isSignedIn();
      allow create: if (isOwner(userId) && isValidId(userId) && isValidPublicProfile(incoming()) && incoming().id == request.auth.uid) ||
                     (isAdmin() && isValidId(userId) && isValidPublicProfile(incoming()));
      allow update: if isAdmin() ||
                     (isOwner(userId) && isValidId(userId) && isValidPublicProfile(incoming()) &&
                      incoming().id == existing().id && incoming().createdAt == existing().createdAt) ||
                     (isSignedIn() && isValidId(userId) && isValidPublicProfile(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followers'])) ||
                     (isSignedIn() && isValidId(userId) && isValidPublicProfile(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['points']) &&
                      incoming().points is number &&
                      (!('points' in existing()) || incoming().points <= existing().points + 10000)) ||
                     (isSignedIn() && isValidId(userId) && isValidPublicProfile(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['points', 'referralsCount', 'referralEarnedPoints', 'dailyReferralDate', 'dailyReferralsCount']) &&
                      incoming().points is number &&
                      (!('points' in existing()) || incoming().points <= existing().points + 1000));
      allow delete: if isAdmin();
    }

    match /reels/{reelId} {
      // Public reels are viewable by guests (unauthenticated) and email-verified users; writes require verified auth
      allow get: if (request.auth == null || isSignedIn()) && isValidId(reelId);
      allow list: if request.auth == null || isSignedIn() || isAdmin();
      allow create: if (isSignedIn() && isValidId(reelId) && isValidReel(incoming()) && incoming().userId == request.auth.uid) ||
                     (isAdmin() && isValidId(reelId) && isValidReel(incoming()));
      allow update: if isAdmin() ||
                     (isSignedIn() && isValidId(reelId) && isValidReel(incoming()) &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt) ||
                     (isSignedIn() && isValidId(reelId) && isValidReel(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount', 'viewsCount']));
      allow delete: if isAdmin() || (isSignedIn() && isValidId(reelId) && existing().userId == request.auth.uid);

      match /comments/{commentId} {
        allow get: if (request.auth == null || isSignedIn()) && isValidId(commentId);
        allow list: if request.auth == null || isSignedIn() || isAdmin();
        allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming()) && incoming().userId == request.auth.uid && incoming().reelId == reelId && exists(/databases/$(database)/documents/reels/$(reelId));
        allow delete: if isAdmin() || (isSignedIn() && isValidId(commentId) && existing().userId == request.auth.uid);
        allow update: if isAdmin() ||
                         (isSignedIn() && isValidId(commentId) && isValidComment(incoming()) &&
                          incoming().userId == existing().userId &&
                          incoming().reelId == existing().reelId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
                          incoming().likes is number && incoming().likes >= 0);
      }
    }

    match /stories/{storyId} {
      // Stories are viewable by guests (preview) and verified users; writes require verified ownership or admin
      allow get: if (request.auth == null || isSignedIn()) && isValidId(storyId);
      allow list: if request.auth == null || isSignedIn() || isAdmin();
      allow create: if (isSignedIn() && isValidId(storyId) && isValidStory(incoming()) && incoming().userId == request.auth.uid) ||
                     (isAdmin() && isValidId(storyId) && isValidStory(incoming()));
      allow update: if isAdmin() ||
                     (isSignedIn() && isValidId(storyId) && isValidStory(incoming()) &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt) ||
                     (isSignedIn() && isValidId(storyId) && isValidStory(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'likesCount']));
      allow delete: if isAdmin() || (isSignedIn() && isValidId(storyId) && existing().userId == request.auth.uid);
    }

    match /settings/{settingId} {
      allow get: if (request.auth == null || isSignedIn() || isAdmin()) && isValidId(settingId);
      allow list: if request.auth == null || isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    match /withdrawals/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && isValidId(requestId) && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) && isValidWithdrawal(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /deposits/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && isValidId(requestId) && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) && isValidDeposit(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /live_streams/{liveId} {
      allow get: if (request.auth == null || isSignedIn()) && isValidId(liveId);
      allow list: if request.auth == null || isSignedIn() || isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(liveId) &&
                       incoming().keys().hasAll(['id', 'hostId', 'hostName', 'title', 'mode', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['id', 'hostId', 'hostName', 'hostAvatar', 'title', 'mode', 'category', 'pinnedNotice', 'isMicMuted', 'isCameraOn', 'chatEnabled', 'allowSpeakerRequests', 'viewersCount', 'peakViewersCount', 'peakAt', 'likesCount', 'giftsTotalPoints', 'adminGiftPoints', 'coHosts', 'status', 'cancelledByAdmin', 'cancelReason', 'createdAt', 'endedAt']) &&
                       (incoming().hostId == request.auth.uid || isAdmin()) &&
                       incoming().mode in ['audio', 'video'] &&
                       incoming().status == 'active' &&
                       incoming().title is string && incoming().title.size() <= 140 &&
                       (!('peakViewersCount' in incoming()) || (incoming().peakViewersCount is number && incoming().peakViewersCount >= 0)) &&
                       (!('peakAt' in incoming()) || (incoming().peakAt is string && incoming().peakAt.size() <= 64));
      allow update: if isAdmin() ||
                       (isSignedIn() && isValidId(liveId) && existing().hostId == request.auth.uid &&
                        incoming().keys().hasOnly(['id', 'hostId', 'hostName', 'hostAvatar', 'title', 'mode', 'category', 'pinnedNotice', 'isMicMuted', 'isCameraOn', 'chatEnabled', 'allowSpeakerRequests', 'viewersCount', 'peakViewersCount', 'peakAt', 'likesCount', 'giftsTotalPoints', 'adminGiftPoints', 'coHosts', 'status', 'cancelledByAdmin', 'cancelReason', 'createdAt', 'endedAt']) &&
                        incoming().hostId == existing().hostId &&
                        incoming().mode in ['audio', 'video'] &&
                        incoming().status in ['active', 'ended']) ||
                       (isSignedIn() && isValidId(liveId) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'viewersCount', 'peakViewersCount', 'peakAt', 'giftsTotalPoints', 'adminGiftPoints']) &&
                        (!('likesCount' in incoming()) || (incoming().likesCount is number && incoming().likesCount >= 0)) &&
                        (!('viewersCount' in incoming()) || (incoming().viewersCount is number && incoming().viewersCount >= 0)) &&
                        (!('peakViewersCount' in incoming()) || (incoming().peakViewersCount is number && incoming().peakViewersCount >= 0 && (!('peakViewersCount' in existing()) || incoming().peakViewersCount >= existing().peakViewersCount))) &&
                        (!('peakAt' in incoming()) || (incoming().peakAt is string && incoming().peakAt.size() <= 64)) &&
                        (!('giftsTotalPoints' in incoming()) || (incoming().giftsTotalPoints is number && incoming().giftsTotalPoints >= 0)) &&
                        (!('adminGiftPoints' in incoming()) || (incoming().adminGiftPoints is number && incoming().adminGiftPoints >= 0)));
      allow delete: if isAdmin() || (isSignedIn() && isValidId(liveId) && existing().hostId == request.auth.uid);

      match /chat/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId);
        allow list: if isAdmin() || isSignedIn();
        allow create: if isSignedIn() &&
                         incoming().keys().hasAll(['userId', 'userName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'userName', 'userAvatar', 'text', 'type', 'giftId', 'giftIcon', 'giftName', 'giftPoints', 'createdAt']) &&
                         (incoming().userId == request.auth.uid || isAdmin()) &&
                         incoming().text is string && incoming().text.size() <= 400;
        allow delete: if isAdmin() ||
                         (isSignedIn() && (
                           existing().userId == request.auth.uid ||
                           get(/databases/$(database)/documents/live_streams/$(liveId)).data.hostId == request.auth.uid
                         ));
      }

      match /requests/{requestId} {
        allow get: if isSignedIn() && isValidId(requestId);
        allow list: if isAdmin() || isSignedIn();
        allow create: if isSignedIn() &&
                         isValidId(requestId) &&
                         incoming().keys().hasAll(['userId', 'userName', 'status', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'userName', 'userAvatar', 'status', 'createdAt']) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'pending';
        allow update: if isAdmin() ||
                         (isSignedIn() && isValidId(requestId) && (
                           existing().userId == request.auth.uid ||
                           get(/databases/$(database)/documents/live_streams/$(liveId)).data.hostId == request.auth.uid
                         ));
        allow delete: if isAdmin() ||
                         (isSignedIn() && isValidId(requestId) && (
                           existing().userId == request.auth.uid ||
                           get(/databases/$(database)/documents/live_streams/$(liveId)).data.hostId == request.auth.uid
                         ));
      }

      match /viewers/{viewerId} {
        allow get: if isSignedIn() && isValidId(viewerId);
        allow list: if isAdmin() || isSignedIn();
        allow create, update: if isSignedIn() && isValidId(viewerId) && (viewerId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && isValidId(viewerId) && (viewerId == request.auth.uid || isAdmin());
      }

      match /rtc/{peerId} {
        allow get: if isSignedIn() && isValidId(peerId);
        allow list: if isAdmin() || isSignedIn();
        allow create, update: if isSignedIn() && isValidId(peerId) &&
                                incoming().keys().hasAll(['id', 'type', 'updatedAt']) &&
                                incoming().keys().hasOnly(['id', 'type', 'viewerId', 'viewerName', 'hostId', 'status', 'offer', 'answer', 'hostCandidates', 'viewerCandidates', 'frameDataUrl', 'audioLevel', 'isCameraOn', 'isMicMuted', 'updatedAt']) &&
                                incoming().type in ['peer', 'preview'] &&
                                (!('frameDataUrl' in incoming()) || incoming().frameDataUrl == null || (incoming().frameDataUrl is string && incoming().frameDataUrl.size() <= 160000)) &&
                                (
                                  isAdmin() ||
                                  (peerId == request.auth.uid && incoming().type == 'peer') ||
                                  get(/databases/$(database)/documents/live_streams/$(liveId)).data.hostId == request.auth.uid
                                );
        allow delete: if isAdmin() || (
                        isSignedIn() && isValidId(peerId) && (
                          peerId == request.auth.uid ||
                          get(/databases/$(database)/documents/live_streams/$(liveId)).data.hostId == request.auth.uid
                        )
                      );
      }
    }

    match /chats/{sessionId} {
      allow get: if isAdmin() || (isSignedIn() && isValidId(sessionId) && request.auth.uid in existing().participants);
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isAdmin() || (isSignedIn() && isValidId(sessionId) && isValidChatSession(incoming()) && request.auth.uid in incoming().participants);
      allow update: if isAdmin() || (isSignedIn() && isValidId(sessionId) && isValidChatSession(incoming()) && request.auth.uid in existing().participants && incoming().participants == existing().participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(sessionId)).data.participants);
        allow create: if isAdmin() || (isSignedIn() && isValidChatMessage(incoming()) && request.auth.uid in get(/databases/$(database)/documents/chats/$(sessionId)).data.participants && incoming().senderId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId);
      allow list: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() && isValidId(taskId) &&
                               incoming().keys().hasAll(['title', 'rewardPoints', 'category']) &&
                               incoming().keys().hasOnly([
                                 'id', 'title', 'description', 'badgeText', 'rewardPoints', 'category',
                                 'iconName', 'completed', 'actionUrl', 'isActive', 'requirementType',
                                 'requirementValue', 'isRepeatableDaily', 'sortOrder', 'createdAt', 'updatedAt'
                               ]) &&
                               incoming().title is string && incoming().title.size() <= 160 &&
                               incoming().rewardPoints is number && incoming().rewardPoints >= 0 &&
                               incoming().category is string && incoming().category.size() <= 60 &&
                               (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500)) &&
                               (!('badgeText' in incoming()) || (incoming().badgeText is string && incoming().badgeText.size() <= 60)) &&
                               (!('actionUrl' in incoming()) || (incoming().actionUrl is string && incoming().actionUrl.size() <= 500)) &&
                               (!('isActive' in incoming()) || incoming().isActive is bool) &&
                               (!('requirementType' in incoming()) || incoming().requirementType in ['instant', 'referral_count', 'reels_watched', 'daily_checkin']) &&
                               (!('requirementValue' in incoming()) || (incoming().requirementValue is number && incoming().requirementValue >= 0)) &&
                               (!('isRepeatableDaily' in incoming()) || incoming().isRepeatableDaily is bool) &&
                               (!('sortOrder' in incoming()) || incoming().sortOrder is number);
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
